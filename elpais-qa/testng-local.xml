<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Local Parallel Suite" parallel="tests" thread-count="2">
    
    <!-- Chrome Local Execution -->
    <test name="LocalChrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.elpaisqa.tests.LocalTest"/>
        </classes>
    </test>
    
    <!-- Firefox Local Execution -->
    <test name="LocalFirefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.elpaisqa.tests.LocalTest"/>
        </classes>
    </test>
    
</suite>
