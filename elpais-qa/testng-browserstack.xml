<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BrowserStack Parallel Suite" parallel="tests" thread-count="5">
    
    <!-- Chrome on Windows 11 -->
    <test name="ChromeWindows11">
        <parameter name="platformType" value="desktop"/>
        <parameter name="browser" value="chrome"/>
        <parameter name="os" value="Windows"/>
        <parameter name="osVersion" value="11"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="deviceName" value=""/>
        <classes>
            <class name="com.elpaisqa.tests.BrowserStackParallelTest"/>
        </classes>
    </test>
    
    <!-- Firefox on macOS -->
    <test name="FirefoxMacVentura">
        <parameter name="platformType" value="desktop"/>
        <parameter name="browser" value="firefox"/>
        <parameter name="os" value="OS X"/>
        <parameter name="osVersion" value="Ventura"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="deviceName" value=""/>
        <classes>
            <class name="com.elpaisqa.tests.BrowserStackParallelTest"/>
        </classes>
    </test>
    
    <!-- Safari on macOS -->
    <test name="SafariMacSonoma">
        <parameter name="platformType" value="desktop"/>
        <parameter name="browser" value="safari"/>
        <parameter name="os" value="OS X"/>
        <parameter name="osVersion" value="Sonoma"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="deviceName" value=""/>
        <classes>
            <class name="com.elpaisqa.tests.BrowserStackParallelTest"/>
        </classes>
    </test>
    
    <!-- Chrome on Samsung Galaxy S23-->
    <test name="ChromeSamsungS23">
        <parameter name="platformType" value="mobile"/>
        <parameter name="browser" value="chrome"/>
        <parameter name="os" value=""/>
        <parameter name="osVersion" value="13.0"/>
        <parameter name="browserVersion" value=""/>
        <parameter name="deviceName" value="Samsung Galaxy S23"/>
        <classes>
            <class name="com.elpaisqa.tests.BrowserStackParallelTest"/>
        </classes>
    </test>
    
    <!-- Safari on iPhone 14-->
    <test name="SafariIphone14">
        <parameter name="platformType" value="mobile"/>
        <parameter name="browser" value="safari"/>
        <parameter name="os" value=""/>
        <parameter name="osVersion" value="16"/>
        <parameter name="browserVersion" value=""/>
        <parameter name="deviceName" value="iPhone 14"/>
        <classes>
            <class name="com.elpaisqa.tests.BrowserStackParallelTest"/>
        </classes>
    </test>
    
</suite>
